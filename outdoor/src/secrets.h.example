#pragma once

// Plantilla de credenciales locales.
// 1. Copiá este archivo como src/secrets.h
// 2. Completá OTA_PASSWORD y OPENWEATHERMAP_API_KEY
// 3. src/secrets.h está en .gitignore y no se versiona
//
// WiFi NO va acá: WiFiManager abre un portal AP (HOSTNAME en Config.h).
// Ver docs/wifi-manager.md
//
// MQTT (demo público): host/user/topic/password vacía en Config.h.
// No hace falta password MQTT en secrets (broker demo usa "").
// Ver docs/mqtt.md
//
// OpenWeatherMap (gratis):
// 1. Creá cuenta en https://openweathermap.org/api
// 2. Current Weather Data → Subscribe (Free)
// 3. API keys → copiá la key (puede tardar unos minutos en activarse)
// Ubicación: OWM_CITY_ID / OWM_LAT / OWM_LON en Config.h

#define OTA_PASSWORD              "TU_PASSWORD_OTA"
#define OPENWEATHERMAP_API_KEY    "TU_API_KEY_OPENWEATHERMAP"
