#pragma once

// Plantilla de credenciales locales del nodo indoor.
// 1. Copiá este archivo como src/secrets.h
// 2. Completá MQTT_HOST, MQTT_USER, MQTT_PASSWORD y MQTT_TOPIC (mismos que outdoor)
// 3. src/secrets.h está en .gitignore y no se versiona
//
// WiFi se configura con WiFiManager (portal AP). Hostname: Config.h
// o descomentá HOSTNAME acá para override.

// #define HOSTNAME "weather-indoor-01"

// MQTT: host, usuario, password y topic. Puerto y MQTT_STALE_MS en Config.h.
// Password vacía "" es válida (string vacío, no nullptr).
#define MQTT_HOST                 "TU_MQTT_HOST"
#define MQTT_USER                 "TU_MQTT_USER"
#define MQTT_PASSWORD             "TU_MQTT_PASSWORD"
#define MQTT_TOPIC                "TU_MQTT_TOPIC"

// OTA (no implementado en v0.3; reservado):
// #define OTA_PASSWORD "cambia-esto"
